---
// Что входит (раздел 3.2 ТЗ)
const items = [
  ['Авторский план Юрия Строфилова', 'Тренировки до самого старта, неделя за неделей.'],
  ['Личные темпы для каждой тренировки', 'Интервальные, развивающие, длительные и лёгкие пробежки — темп рассчитан под вас.'],
  ['Автоматический разбор каждой тренировки', 'Аналитика после пробежки: что получилось и где запас.'],
  ['План подстраивается под форму', 'Если задание не получилось, следующие тренировки можно пересчитать.'],
  ['Телеграм-бот', 'Задания, напоминания и отчёты приходят в Телеграм.'],
  ['Закрытый чат участников', 'Юрий Строфилов лично отвечает на вопросы.'],
  ['Поддержка с живыми людьми', 'Техническую помощь оказывают люди, а не автоответчик.'],
];
---
<section class="section" id="includes" style="--hm: 2" aria-labelledby="includes-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="includes-h">Что входит в план подготовки</h2>
    </div>
    <ol class="includes">
      {items.map(([t, d], i) => (
        <li class="includes__item">
          <span class="includes__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{t}</h3>
          <p>{d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
