---
const { config } = Astro.props;
const site = (config.site_url || '').replace(/\/$/, '');
const og = site ? `${site}/img/og.jpg` : '/img/og.jpg';
---
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{config.title}</title>
<meta name="description" content={config.description}>
<meta name="keywords" content="подготовка к Казанскому марафону, план на марафон, план на марафон 3 часа, план на марафон 4 часа">
<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="S10.run">
<meta property="og:title" content={`Подготовка к ${config.race_name_dative || config.race_name} с S10.run`}>
<meta property="og:description" content="Авторский план Юрия Строфилова до самого старта, личные темпы для каждой тренировки и живые тренеры S10.run.">
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Карандашный рисунок: марафонцы бегут по набережной Казанки к Кремлю и мечети Кул-Шариф">
{site && <meta property="og:url" content={`${site}/`} />}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={og}>
{site && <link rel="canonical" href={`${site}/`} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#004AAD">
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<link rel="preload" as="image" href="/img/hero-800.webp" imagesrcset="/img/hero-560.webp 560w, /img/hero-800.webp 800w, /img/hero-1200.webp 1200w, /img/hero-1672.webp 1672w" imagesizes="100vw" fetchpriority="high">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/moments/word-highlight/moment.css">
<link rel="stylesheet" href="/s10-tokens.css">
<style is:inline>
/* палитра системы вёрстки, переведённая на токены S10.run */
:root {
  --p-bg: var(--s10-background); --p-surface: var(--s10-surface-alt); --p-ink: var(--s10-text); --p-muted: var(--s10-text-muted);
  --p-accent: var(--s10-primary); --p-accent-ink: #ffffff; --p-action: var(--s10-primary); --p-action-ink: #ffffff;
  --p-inv-bg: var(--s10-primary); --p-inv-surface: var(--s10-primary-hover); --p-inv-ink: #ffffff; --p-inv-muted: #D6DDF5;
  --p-inv-accent: #ffffff; --p-inv-accent-ink: var(--s10-primary); --p-inv-action: #ffffff; --p-inv-action-ink: var(--s10-primary);
  --font-display: "Roboto", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  --font-text: "Roboto", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  --display-weight: 700;
  --display-tracking: -0.015em;
  --display-tracking-xl: -0.02em;
}
</style>
<link rel="stylesheet" href="/landing.css">
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<link rel="modulepreload" href="/assets/moments/word-highlight/moment.js">
</head>
