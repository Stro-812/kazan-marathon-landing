---
const { buyUrl } = Astro.props;
---
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">К содержанию</a>
    <a class="nav__logo" href="#top"><span class="mark" data-mark="ring" aria-hidden="true"></span>S10.run</a>
    <nav class="nav__links" aria-label="Разделы">
      <div class="nav__item"><a class="nav__link" href="#includes">Состав</a></div>
      <div class="nav__item"><a class="nav__link" href="#coach">Куратор</a></div>
      <div class="nav__item"><a class="nav__link" href="#plan">Тренировки</a></div>
      <div class="nav__item"><a class="nav__link" href="#price">Цена</a></div>
      <div class="nav__item"><a class="nav__link" href="#faq">Вопросы</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={buyUrl} data-s10 data-goal="buy_click" data-block="nav">Начать подготовку</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Меню">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
